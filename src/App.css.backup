/* =========================================
   APPLICATION
========================================= */

:root {
  --experience-width: 440px;
  --creator-width: 560px;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.experience-screen {
  position: relative;
  isolation: isolate;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;

  padding: 28px 22px;

  overflow-x: clip;

  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(169, 111, 95, 0.075),
      transparent 54%
    ),
    var(--paper);

  color: var(--ink);
}

.experience-stage {
  position: relative;

  width: min(100%, var(--experience-width));
  min-width: 0;
  margin-inline: auto;
}

/* =========================================
   SHARED RECIPIENT BUTTONS
========================================= */

.experience-button,
.experience-text-button {
  appearance: none;
  -webkit-appearance: none;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  font-family: var(--font-interface);
  text-align: center;
  text-decoration: none;

  cursor: pointer;

  -webkit-tap-highlight-color: transparent;
}

.experience-button {
  min-height: 52px;
  padding: 13px 19px;

  border: 1px solid var(--ink);
  border-radius: 3px;

  background: var(--ink);
  color: var(--paper);

  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.15px;

  box-shadow: 0 2px 0 rgba(41, 38, 36, 0.04);

  transition:
    background-color 220ms ease,
    border-color 220ms ease,
    color 220ms ease,
    transform 220ms ease,
    box-shadow 220ms ease;
}

.experience-button:hover {
  border-color: var(--accent);
  background: var(--accent);
  color: #fffaf6;

  transform: translateY(-2px);
  box-shadow: var(--shadow-button);
}

.experience-button:active {
  transform: translateY(0);
  box-shadow: none;
}

.experience-button:focus-visible,
.experience-text-button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

.experience-text-button {
  min-height: 44px;
  padding: 10px 12px;

  border: 1px solid transparent;
  border-radius: 3px;

  background: transparent;
  color: var(--muted);

  font-size: 12px;
  font-weight: 400;

  transition:
    color 200ms ease,
    background-color 200ms ease,
    border-color 200ms ease;
}

.experience-text-button:hover {
  border-color: rgba(169, 111, 95, 0.2);
  background: rgba(169, 111, 95, 0.07);
  color: var(--ink);
}

/* =========================================
   OPENING — PERSONALIZED KEEPSAKE
========================================= */

.experience-opening .experience-stage {
  width: 100%;
  min-width: 0;
}

.experience-opening .opening-content {
  display: flex;
  flex-direction: column;
  align-items: center;

  width: min(390px, calc(100% - 40px));
  margin-inline: auto;
  padding: 34px 0 28px;

  text-align: center;

  animation: openingArrive 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.opening-topline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2px;
  line-height: 1.5;
}

.opening-topline-dot {
  width: 3px;
  height: 3px;
  flex: 0 0 3px;

  border-radius: 50%;
  background: var(--accent);
}

.opening-personal {
  width: 100%;
  margin-top: 48px;
}

.experience-opening .opening-prelude {
  margin: 0 0 4px;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.5px;
}

.experience-opening .opening-name {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(3.6rem, 15vw, 5.2rem);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.5px;

  overflow-wrap: anywhere;
}

.opening-name-period {
  color: var(--accent);
}

.opening-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;

  width: 108px;
  margin-top: 27px;
}

.opening-divider-line {
  height: 1px;
  flex: 1;

  background: rgba(169, 111, 95, 0.45);
}

.opening-divider-center {
  display: inline-block;

  color: var(--accent);
  font-size: 12px;
  line-height: 1;

  animation: openingMotif 7s ease-in-out infinite;
}

.opening-message-wrap {
  max-width: 310px;
  margin-top: 30px;
}

.experience-opening .opening-message {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(1.9rem, 7vw, 2.35rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.35px;

  text-wrap: balance;
}

.opening-subtext {
  max-width: 270px;
  margin: 13px auto 0;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.8;
}

.experience-opening .opening-button {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;
  min-height: 54px;
  margin-top: 34px;
  padding: 0 19px;

  border-radius: 3px;

  font-size: 12px;
}

.opening-button-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 18px;
  line-height: 1;

  transition: transform 220ms ease;
}

.experience-opening .opening-button:hover .opening-button-arrow {
  transform: translate(2px, -2px);
}

.opening-footer {
  margin: 25px 0 0;

  color: var(--soft);

  font-family: var(--font-interface);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 2px;
  line-height: 1.5;
}

/* =========================================
   QUESTION — DINNER WITH ME?
========================================= */

.experience-question .experience-stage {
  width: 100%;
  min-width: 0;
}

.experience-question .question-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  width: min(390px, 100%);
  min-height: min(690px, 100%);
  margin-inline: auto;
  padding: 36px 0 30px;

  text-align: center;

  animation: questionArrive 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.question-topline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  width: 100%;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2px;
  line-height: 1.6;
}

.question-topline-line {
  width: 24px;
  height: 1px;
  flex: 0 0 24px;

  background: rgba(169, 111, 95, 0.55);
}

.question-personal {
  width: 100%;
  margin-top: 48px;
}

.experience-question .question-recipient {
  margin: 0 0 15px;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.4px;
  line-height: 1.6;
}

.question-recipient span {
  color: var(--ink);
  font-weight: 500;
}

.experience-question .question-title {
  max-width: 100%;
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(3rem, 11.5vw, 4.25rem);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;

  overflow-wrap: anywhere;
  text-wrap: balance;
}

.question-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  width: 112px;
  margin: 27px auto 0;
}

.question-divider-line {
  height: 1px;
  flex: 1;

  background: rgba(169, 111, 95, 0.42);
}

.question-divider-mark {
  display: inline-block;

  color: var(--accent);
  font-size: 13px;
  line-height: 1;

  animation: questionMotif 8s ease-in-out infinite;
}

/* Schedule */

.experience-question .question-schedule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;

  width: 100%;
  margin-top: 35px;
  padding: 17px 4px;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  text-align: left;
}

.question-calendar-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 40px;
  height: 40px;
  flex: 0 0 40px;

  border-radius: 50%;

  background: rgba(169, 111, 95, 0.09);
  color: var(--accent);
}

.question-schedule-copy {
  min-width: 0;
}

.experience-question .question-schedule-date {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 500;
  line-height: 1.7;

  overflow-wrap: anywhere;
}

.experience-question .question-schedule-time {
  margin: 2px 0 0;

  color: var(--muted);

  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
}

/* Actions */

.experience-question .question-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8px;

  width: 100%;
  margin-top: 30px;
}

.experience-question .question-primary-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  width: 100%;
  min-height: 58px;
  padding: 0 20px;

  border-radius: 3px;

  font-size: 13px;
  letter-spacing: 0.15px;
}

.question-button-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 19px;
  line-height: 1;

  transition: transform 220ms ease;
}

.experience-question .question-primary-button:hover .question-button-arrow {
  transform: translate(2px, -2px);
}

.experience-question .question-secondary-button {
  min-height: 46px;
  padding: 10px 12px;
}

.question-footer {
  margin: 24px 0 0;

  color: var(--soft);

  font-family: var(--font-interface);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 1.8px;
  line-height: 1.7;
}

/* =========================================
   REVEAL — PLAN DETAILS
========================================= */

.experience-revealing .experience-stage {
  width: 100%;
  max-width: 420px;
}

.reveal-screen {
  width: 100%;
  margin-inline: auto;
  padding: 24px 22px 32px;
}

.reveal-header {
  margin-bottom: 30px;
  text-align: center;
}

.reveal-header h1 {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(2.4rem, 9vw, 3.2rem);
  font-weight: 500;
  line-height: 1.05;
}

.reveal-header p {
  max-width: 300px;
  margin: 12px auto 0;

  color: var(--muted);

  font-family: var(--font-editorial);
  font-size: 1.25rem;
  line-height: 1.4;
}

.reveal-content {
  display: flex;
  flex-direction: column;
  gap: 20px;

  width: 100%;
}

.reveal-detail {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  animation: revealItemIn 500ms ease both;
}

.reveal-detail > svg {
  flex: 0 0 auto;
  margin-top: 3px;

  color: var(--accent);
}

.reveal-detail p {
  margin: 0;

  color: var(--ink);

  font-size: 0.98rem;
  line-height: 1.65;
}

.reveal-wear p span {
  color: var(--muted);
}

/* Destination */

.reveal-destination {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  margin-top: 2px;
  padding: 18px 0;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  animation: revealItemIn 600ms ease both;
}

.reveal-destination > svg {
  flex: 0 0 auto;
  margin-top: 5px;

  color: var(--accent);
}

.reveal-destination-copy {
  min-width: 0;
}

.reveal-destination-copy h2 {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(1.65rem, 6vw, 2.1rem);
  font-weight: 500;
  line-height: 1.15;

  overflow-wrap: anywhere;
}

.reveal-destination-copy p {
  margin: 6px 0 0;

  color: var(--muted);

  font-size: 0.9rem;
  line-height: 1.5;
}

.reveal-destination-copy a {
  display: inline-flex;
  align-items: center;

  min-height: 40px;
  margin-top: 8px;

  color: var(--accent);

  font-size: 0.83rem;
  font-weight: 500;

  text-decoration: underline;
  text-decoration-color: rgba(169, 111, 95, 0.45);
  text-underline-offset: 3px;
}

.reveal-destination-copy a:hover {
  color: var(--ink);
}

/* Destination hint */

.reveal-destination-hint {
  padding-left: 12px;

  border-left: 2px solid rgba(169, 111, 95, 0.5);

  animation: revealItemIn 500ms ease both;
}

.reveal-destination-hint p {
  margin: 0;

  color: var(--muted);

  font-size: 0.92rem;
  line-height: 1.55;
}

.reveal-destination-hint p + p {
  margin-top: 4px;
  color: var(--ink);
}

/* Personal note */

.reveal-note {
  padding-top: 4px;

  animation: revealItemIn 600ms ease both;
}

.reveal-note p {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: 1.35rem;
  font-weight: 500;
  line-height: 1.5;

  overflow-wrap: anywhere;
}

/* Continue action — prepared for reveal component */

.reveal-continue {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;
  min-height: 54px;
  margin-top: 30px;
  padding: 0 18px;

  border: 1px solid var(--ink);
  border-radius: 3px;

  background: var(--ink);
  color: var(--paper);

  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 500;

  cursor: pointer;

  animation: revealItemIn 500ms ease both;

  transition:
    background-color 220ms ease,
    border-color 220ms ease,
    transform 220ms ease,
    box-shadow 220ms ease;
}

.reveal-continue:hover {
  border-color: var(--accent);
  background: var(--accent);

  transform: translateY(-2px);
  box-shadow: var(--shadow-button);
}

.reveal-continue:active {
  transform: translateY(0);
  box-shadow: none;
}

.reveal-continue:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

.reveal-continue-arrow {
  font-size: 18px;
  line-height: 1;
}

/* =========================================
   COMPLETION
========================================= */

.experience-complete .experience-stage,
.experience-declined .experience-stage {
  width: 100%;
}

.ending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  width: min(100%, 390px);
  min-height: 360px;
  margin-inline: auto;
  padding: 32px 20px;

  text-align: center;

  animation: endingArrive 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.ending-content::before {
  content: "✳";

  display: block;
  margin-bottom: 30px;

  color: var(--accent);

  font-family: var(--font-editorial);
  font-size: 18px;
  line-height: 1;

  animation: openingMotif 7s ease-in-out infinite;
}

.ending-message {
  max-width: 290px;
  margin: 0 0 12px;

  color: var(--accent);

  font-family: var(--font-editorial);
  font-size: 1.3rem;
  font-style: italic;
  line-height: 1.5;
}

.ending-title {
  margin: 0;

  color: var(--ink);

  font-family: var(--font-editorial);
  font-size: clamp(3.2rem, 12vw, 4.6rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -1px;
}

.ending-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 9px;

  width: min(100%, 290px);
  margin: 34px auto 0;
}

.ending-actions .experience-button,
.ending-actions .experience-text-button {
  width: 100%;
  min-height: 48px;
  box-sizing: border-box;
}

/* =========================================
   DECLINED
========================================= */

.experience-declined .ending-content {
  min-height: 300px;
}

.experience-declined .ending-message {
  max-width: 300px;
  margin-bottom: 24px;

  color: var(--ink);

  font-size: clamp(1.8rem, 7vw, 2.3rem);
  font-style: normal;
  line-height: 1.25;
}

/* =========================================
   CREATOR BUILDER — CONTEMPORARY KEEPSAKE
   Single source of truth for creator workspace styles.
========================================= */

.creator-page {
  min-height: 100vh;
  min-height: 100dvh;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(169, 111, 95, 0.075), transparent 62%),
    var(--paper);
  color: var(--ink);
}

.creator-builder {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: min(100% - 48px, 1240px);
  min-height: 100vh;
  min-height: 100dvh;
  margin-inline: auto;
  padding: 24px 0 16px;
  background: transparent;
  color: var(--ink);
}

.creator-header {
  position: relative;
  width: 100%;
  margin: 0 auto 22px;
  text-align: left;
}

.creator-header::after { content: none; }

.creator-header-topline {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 7px;
}

.creator-header--compact .creator-header-mark {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border: 1px solid rgba(169, 111, 95, 0.38);
  border-radius: 50%;
  color: var(--accent);
  font-size: 14px;
}

.creator-eyebrow {
  margin: 0;
  color: var(--accent);
  font-family: var(--font-interface);
  font-size: 0.59rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  line-height: 1.4;
  text-transform: uppercase;
}

.creator-header h1,
.creator-header--compact .creator-title {
  margin: 0;
  color: var(--ink);
  font-family: var(--font-editorial);
  font-size: clamp(2.2rem, 4vw, 3rem);
  font-weight: 500;
  line-height: 1.03;
  letter-spacing: -0.035em;
}

.creator-title-period { color: var(--accent); }
.creator-header h1 span { color: var(--accent); }
.creator-header--compact .creator-subtitle { display: none; }

.creator-workspace-grid {
  display: grid;
  grid-template-columns: 0.94fr 1.08fr 0.94fr;
  align-items: stretch;
  gap: 16px;
  width: 100%;
}

.creator-panel {
  min-width: 0;
  padding: 17px;
  border: 1px solid rgba(64, 51, 44, 0.13);
  border-radius: 4px;
  background: rgba(255, 253, 249, 0.66);
}

.creator-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 11px;
  margin-bottom: 13px;
  border-bottom: 1px solid rgba(64, 51, 44, 0.12);
}

.creator-panel-kicker {
  color: #8d6a5d;
  font-family: var(--font-interface);
  font-size: 0.61rem;
  font-weight: 600;
  letter-spacing: 0.14em;
}

.creator-panel-flourish { color: var(--accent); font-size: 17px; }
.creator-section-number { display: none !important; }

.creator-workspace .creator-field {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  margin: 0 0 12px;
}

.creator-workspace .creator-field:last-child { margin-bottom: 0; }

.creator-workspace .creator-field label,
.creator-workspace .creator-field > span {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0 0 5px;
  color: #514740;
  font-family: var(--font-interface);
  font-size: 0.7rem;
  font-weight: 500;
  line-height: 1.4;
}

.creator-optional-label { margin-left: auto; color: #a1968d; font-size: 0.63rem; font-weight: 400; }

.creator-workspace .creator-field input,
.creator-workspace .creator-field textarea {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: 9px 10px;
  border: 1px solid rgba(64, 51, 44, 0.17);
  border-radius: 3px;
  outline: none;
  background: #fffdf9;
  color: var(--ink);
  font-family: var(--font-interface);
  font-size: 0.78rem;
  font-weight: 400;
  line-height: 1.4;
  transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
}

.creator-workspace .creator-field input { min-height: 36px; }
.creator-workspace .creator-field textarea { min-height: 58px; resize: vertical; }
.creator-workspace .creator-field input::placeholder,
.creator-workspace .creator-field textarea::placeholder { color: rgba(41, 38, 36, 0.42); }
.creator-workspace .creator-field input:focus,
.creator-workspace .creator-field textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(169, 111, 95, 0.09);
  background: #fff;
}
.creator-workspace .creator-field-hint { display: none; }

.creator-workspace .creator-question-wrap { position: relative; }
.creator-workspace .creator-question-wrap textarea {
  min-height: 70px;
  padding-right: 44px;
  font-family: var(--font-editorial);
  font-size: 1.3rem;
  line-height: 1.25;
}

.creator-workspace .creator-emoji-trigger {
  position: absolute;
  top: 8px;
  right: 8px;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  padding: 0;
  transform: none;
  border: 1px solid rgba(169, 111, 95, 0.28);
  border-radius: 50%;
  background: #f8f0eb;
  color: var(--accent);
  font-size: 1rem;
  cursor: pointer;
  transition: background-color 180ms ease, transform 180ms ease;
}
.creator-workspace .creator-emoji-trigger:hover { transform: rotate(-8deg); background: #f0dfd6; }

.creator-workspace .creator-emoji-picker {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  width: 100%;
  margin-top: 7px;
  padding: 8px;
  border: 1px solid rgba(64, 51, 44, 0.13);
  border-radius: 4px;
  background: #fffdf9;
  box-shadow: 0 8px 24px rgba(41, 38, 36, 0.06);
  animation: emojiAppear 160ms ease-out both;
}
.creator-workspace .creator-emoji-option { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid transparent; border-radius: 50%; background: transparent; font-size: 1rem; cursor: pointer; }
.creator-workspace .creator-emoji-option:hover { border-color: rgba(169, 111, 95, 0.35); background: #f8f0eb; }

.creator-mood-options--compact {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

.creator-workspace .creator-mood-option--tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8px;
  min-width: 0;
  min-height: 76px;
  padding: 10px;
  border: 1px solid rgba(64, 51, 44, 0.16);
  border-radius: 4px;
  background: #fffdf9;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
}
.creator-workspace .creator-mood-option--tile:hover { transform: translateY(-1px); border-color: rgba(169, 111, 95, 0.65); }
.creator-workspace .creator-mood-option--tile.is-selected { border-color: var(--accent); background: #f6eae3; }
.creator-workspace .creator-mood-symbol { color: var(--accent); font-size: 19px; line-height: 1; }
.creator-workspace .creator-mood-name { font-family: var(--font-interface); font-size: 0.72rem; font-weight: 500; }
.creator-workspace .creator-mood-description { display: none; }
.creator-workspace .creator-mood-check { position: absolute; top: 7px; right: 8px; color: var(--accent); font-size: 0.65rem; }

.creator-details-disclosure { border-bottom: 1px solid rgba(64, 51, 44, 0.13); }
.creator-details-disclosure summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  color: #39332f;
  font-family: var(--font-interface);
  font-size: 0.78rem;
  list-style: none;
  cursor: pointer;
}
.creator-details-disclosure summary::-webkit-details-marker { display: none; }
.creator-details-disclosure summary::marker { content: ""; }
.creator-details-chevron { display: grid; place-items: center; flex: 0 0 24px; width: 24px; height: 24px; border: 1px solid rgba(169, 111, 95, 0.3); border-radius: 50%; color: var(--accent); font-size: 1rem; transition: transform 180ms ease; }
.creator-details-disclosure[open] .creator-details-chevron { transform: rotate(45deg); }
.creator-details-content { padding: 10px 0 3px; animation: creatorMoreEnter 180ms ease both; }
.creator-personal-note { margin: 13px 0 0; color: #8d8179; font-family: var(--font-editorial); font-size: 1rem; font-style: italic; }

.creator-workspace .creator-footer--refined {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  width: 100%;
  max-width: none;
  margin: 17px auto 0;
  padding: 0;
}
.creator-workspace .creator-create-link-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  min-height: 45px;
  padding: 0 20px;
  border: 1px solid var(--accent);
  border-radius: 3px;
  background: var(--accent);
  color: #fffaf5;
  font-family: var(--font-interface);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 180ms ease, transform 180ms ease;
}
.creator-workspace .creator-create-link-button:hover { transform: translateY(-1px); background: #925b4d; }
.creator-workspace .creator-preview-link { padding: 8px 0; border: 0; background: transparent; color: #62564f; font-family: var(--font-interface); font-size: 0.72rem; text-decoration: underline; text-decoration-color: rgba(98, 86, 79, 0.35); text-underline-offset: 4px; cursor: pointer; }
.creator-workspace .creator-preview-link:hover { color: var(--accent); }
.creator-bottom-note { margin: 12px 0 0; color: #a69a91; font-family: var(--font-interface); font-size: 0.52rem; letter-spacing: 0.18em; text-align: center; }
.creator-link-error { margin: 10px auto; color: #9b4038; font-size: 0.75rem; text-align: center; }

.creator-workspace .creator-share-panel--refined {
  box-sizing: border-box;
  width: min(100%, 500px);
  margin: 16px auto 0;
  padding: 16px;
  border: 1px solid rgba(169, 111, 95, 0.24);
  border-radius: 4px;
  background: #fffdf9;
  text-align: left;
  animation: share-panel-enter 350ms ease both;
}
.creator-workspace .creator-share-heading { display: flex; align-items: center; gap: 11px; margin-bottom: 13px; }
.creator-workspace .creator-share-heading h2 { margin: 0 0 3px; color: var(--ink); font-family: var(--font-editorial); font-size: 1.45rem; font-weight: 500; }
.creator-workspace .creator-share-heading p { margin: 0; color: var(--muted); font-size: 0.72rem; }
.creator-workspace .creator-share-mark { display: grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; border-radius: 50%; background: #f6eae3; color: var(--accent); font-size: 1rem; }
.creator-workspace .creator-share-link-caption { display: block; margin-bottom: 5px; color: #8d6a5d; font-size: 0.56rem; letter-spacing: 0.12em; }
.creator-workspace .creator-share-link-input { box-sizing: border-box; width: 100%; min-height: 36px; padding: 8px; border: 1px solid rgba(64, 51, 44, 0.16); border-radius: 3px; background: #faf8f4; color: #62564f; font-family: var(--font-interface); font-size: 0.68rem; }
.creator-workspace .creator-copy-button { width: 100%; min-height: 39px; margin-top: 8px; border: 1px solid var(--accent); border-radius: 3px; background: var(--accent); color: #fff; font-family: var(--font-interface); font-size: 0.73rem; cursor: pointer; }
.creator-workspace .creator-share-secondary { display: flex; justify-content: center; flex-wrap: wrap; gap: 18px; margin-top: 10px; }
.creator-workspace .creator-share-secondary button { padding: 4px 0; border: 0; background: transparent; color: #62564f; font-family: var(--font-interface); font-size: 0.68rem; cursor: pointer; }
.creator-workspace .creator-share-secondary button:hover { color: var(--accent); }

.creator-bottom-note { letter-spacing: 0.16em; }

/* Desktop viewport fit: compact proportions on normal laptop displays. */
@media (min-width: 1050px) and (min-height: 700px) {
  .creator-builder { padding-top: 17px; padding-bottom: 12px; }
  .creator-header { margin-bottom: 16px; }
  .creator-panel { padding: 14px; }
  .creator-panel-heading { padding-bottom: 9px; margin-bottom: 10px; }
  .creator-workspace .creator-field { margin-bottom: 9px; }
  .creator-workspace .creator-field input { min-height: 33px; padding-block: 6px; }
  .creator-workspace .creator-field textarea { min-height: 50px; padding-block: 7px; }
  .creator-workspace .creator-question-wrap textarea { min-height: 61px; }
  .creator-workspace .creator-mood-option--tile { min-height: 68px; }
  .creator-workspace .creator-footer--refined { margin-top: 12px; }
  .creator-bottom-note { margin-top: 8px; }
}

@media (max-width: 1049px) {
  .creator-builder { width: min(100% - 40px, 760px); }
  .creator-workspace-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .creator-panel--personal { grid-column: 1 / -1; }
  .creator-details-content { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
}

@media (max-width: 640px) {
  .creator-builder { width: min(100% - 28px, 480px); padding: 20px 0 16px; }
  .creator-header { margin-bottom: 16px; }
  .creator-header--compact .creator-title { font-size: 2.2rem; }
  .creator-workspace-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .creator-panel { padding: 15px; }
  .creator-panel--personal { grid-column: auto; }
  .creator-details-content { display: block; }
  .creator-workspace .creator-field { margin-bottom: 12px; }
  .creator-workspace .creator-field input { min-height: 40px; }
  .creator-workspace .creator-mood-option--tile { min-height: 74px; }
  .creator-workspace .creator-footer--refined { flex-direction: column; gap: 6px; margin-top: 15px; }
  .creator-workspace .creator-create-link-button { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .creator-workspace *,
  .creator-workspace *::before,
  .creator-workspace *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* Preview shell */

.preview-shell {
  position: relative;

  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;

  background: var(--paper);
}

.preview-back-button {
  position: fixed;
  z-index: 20;
  top: 16px;
  left: 16px;

  padding: 8px 12px;

  border: 1px solid rgba(41, 38, 36, 0.14);
  border-radius: 999px;

  background: rgba(250, 248, 244, 0.9);
  color: var(--ink);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  font-family: var(--font-interface);
  font-size: 0.68rem;
  font-weight: 500;

  cursor: pointer;

  transition:
    background-color 200ms ease,
    border-color 200ms ease,
    transform 200ms ease;
}

.preview-back-button:hover {
  border-color: rgba(41, 38, 36, 0.28);
  background: rgba(250, 248, 244, 0.98);
  transform: translateY(-1px);
}

/* =========================================
   ANIMATIONS
========================================= */

@keyframes openingArrive {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes openingMotif {
  0%,
  100% {
    transform: rotate(0deg);
    opacity: 0.75;
  }

  50% {
    transform: rotate(45deg);
    opacity: 1;
  }
}

@keyframes questionArrive {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes questionMotif {
  0%,
  100% {
    transform: rotate(0deg);
    opacity: 0.75;
  }

  50% {
    transform: rotate(45deg);
    opacity: 1;
  }
}

@keyframes revealItemIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes endingArrive {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes creatorMoreEnter {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes emojiAppear {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 600px) {
  .creator-divider {
    margin: 36px 0;
  }

  .creator-group-heading {
    margin-bottom: 24px;
  }

  .creator-field-row {
    gap: 16px;
  }

  .creator-destination {
    padding: 16px 15px 1px;
  }

  .creator-footer {
    margin-top: 40px;
  }

  .creator-footer .primary-button {
    width: 100%;
  }
}

@media (max-width: 380px) {
  .experience-screen {
    padding: 20px 18px;
  }

  .experience-opening .opening-content {
    width: 100%;
    padding-top: 27px;
  }

  .opening-personal {
    margin-top: 38px;
  }

  .opening-divider {
    margin-top: 23px;
  }

  .opening-message-wrap {
    margin-top: 25px;
  }

  .experience-opening .opening-button {
    margin-top: 28px;
  }

  .opening-footer {
    margin-top: 21px;
  }

  .experience-question .question-content {
    width: 100%;
    padding-top: 25px;
    padding-bottom: 24px;
  }

  .question-personal {
    margin-top: 34px;
  }

  .experience-question .question-title {
    font-size: clamp(2.7rem, 11vw, 3.3rem);
  }

  .question-divider {
    margin-top: 22px;
  }

  .experience-question .question-schedule {
    margin-top: 27px;
    padding-block: 14px;
  }

  .experience-question .question-actions {
    margin-top: 24px;
  }

  .question-footer {
    margin-top: 18px;
  }

  .reveal-screen {
    padding: 20px 18px 26px;
  }

  .reveal-header {
    margin-bottom: 24px;
  }

  .reveal-content {
    gap: 17px;
  }

  .reveal-destination {
    padding: 15px 0;
  }

  .creator-builder {
    padding-inline: 17px;
  }

  .creator-header h1 {
    font-size: 2.7rem;
  }

  .creator-composition {
    margin-top: 32px;
  }

  .creator-field-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .creator-mood {
    flex: 1 1 auto;
  }

  .creator-emoji-picker {
    grid-template-columns: repeat(4, minmax(36px, 1fr));
    width: 184px;
  }
}

/* Short screens */

@media (max-height: 700px) {
  .experience-screen {
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .experience-opening .opening-content {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .opening-personal {
    margin-top: 28px;
  }

  .opening-message-wrap {
    margin-top: 22px;
  }

  .experience-opening .opening-button {
    margin-top: 24px;
  }

  .opening-footer {
    margin-top: 18px;
  }

  .experience-question .question-content {
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .question-personal {
    margin-top: 30px;
  }

  .experience-question .question-schedule {
    margin-top: 25px;
  }

  .experience-question .question-actions {
    margin-top: 22px;
  }

  .reveal-header {
    margin-bottom: 22px;
  }

  .reveal-content {
    gap: 16px;
  }
}

/* =========================================
   ACCESSIBILITY
========================================= */

@media (prefers-reduced-motion: reduce) {
  .experience-opening .opening-content,
  .opening-divider-center,
  .experience-question .question-content,
  .question-divider-mark,
  .reveal-detail,
  .reveal-destination,
  .reveal-destination-hint,
  .reveal-note,
  .reveal-continue,
  .ending-content,
  .ending-content::before,
  .creator-more-content,
  .creator-emoji-picker {
    animation: none;
  }

  .experience-button,
  .experience-text-button,
  .opening-button-arrow,
  .question-button-arrow,
  .creator-field input,
  .creator-field textarea,
  .creator-mood,
  .creator-more-toggle,
  .creator-more-icon,
  .creator-emoji-trigger,
  .creator-emoji-option,
  .preview-back-button,
  .creator-footer .primary-button,
  .reveal-continue {
    transition: none;
  }
}

/* ========================================
   RECIPIENT PLAN ENDING / CALENDAR ACTION
======================================== */

.reveal-continue {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  width: 100%;
  margin: 2rem auto 0;
  padding: 1.5rem 0 0;
  border-top: 1px solid rgba(169, 111, 95, 0.28);
  animation: share-panel-enter 500ms ease both;
}

.reveal-continue-message {
  margin: 0;
  color: #716962;
  font-family: "Cormorant Garamond", serif;
  font-size: 1.65rem;
  line-height: 1.4;
  text-align: center;
}

.reveal-calendar-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  min-height: 3.25rem;
  padding: 0.85rem 1.4rem;
  border: 1px solid rgba(169, 111, 95, 0.55);
  border-radius: 6px;
  background: #fffdf9;
  color: #292624;
  cursor: pointer;
  transition: transform 220ms ease, background-color 220ms ease, box-shadow 220ms ease;
}
.reveal-calendar-button:hover { transform: translateY(-2px); background: #f8f0eb; box-shadow: 0 8px 20px rgba(110, 65, 53, 0.10); }
.reveal-calendar-button:focus-visible { outline: 2px solid #a96f5f; outline-offset: 4px; }
.reveal-calendar-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 6px; background: #f3e9e2; color: #995f50; }
.reveal-calendar-button-copy { display: flex; flex: 1; flex-direction: column; gap: 0.2rem; text-align: left; }
.reveal-calendar-button-title { color: #39312c; font-family: Inter, sans-serif; font-size: 0.88rem; font-weight: 600; }
.reveal-calendar-button-subtitle { color: #8a7e74; font-size: 0.72rem; font-weight: 400; }
.reveal-calendar-arrow { align-self: center; color: #a96f5f; font-size: 1.05rem; }
.reveal-ending-footer { margin: 1.5rem 0 0; color: #a99c90; font-size: 0.6rem; letter-spacing: 0.17em; }

@media (max-width: 480px) {
  .reveal-continue { margin-top: 2rem; }
  .reveal-calendar-button { gap: 0.65rem; padding: 0.75rem; }
}

@media (prefers-reduced-motion: reduce) {
  .reveal-continue { animation: none; }
  .reveal-calendar-button { transition: none; }
}
